{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": [
    "./node_modules/oxc-config-ai-guardrails/configs/base.json",
    "./node_modules/oxc-config-ai-guardrails/configs/typescript.json"
  ],
  "ignorePatterns": ["dist/**", "dev-dist/**", "research/**", ".scratch/**"],
  "options": {
    "reportUnusedDisableDirectives": "error"
  },
  "overrides": [
    {
      "files": ["src/sound/levels.ts"],
      "rules": { "max-lines": "off" }
    },
    {
      "files": ["src/model/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/shell", "**/shell/**", "**/sound", "**/sound/**", "**/ui", "**/ui/**"],
                "message": "The game model imports no other layer."
              },
              {
                "group": ["pixi.js", "pixi.js/**", "solid-js", "solid-js/**"],
                "message": "The game model is pure TypeScript: no view package."
              }
            ]
          }
        ]
      }
    }
  ]
}
