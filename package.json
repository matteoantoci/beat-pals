{
  "name": "beat-pals",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "smoke": "vite build --mode smoke && node scripts/smoke.ts",
    "deploy": "node scripts/deploy.ts",
    "prepare-song": "node scripts/prepare-song.ts",
    "leak-scan": "node scripts/leak-scan.ts history",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "lint": "oxlint",
    "lint:types": "oxlint --type-aware",
    "typecheck": "tsc --noEmit && tsc -p scripts --noEmit",
    "knip": "knip && knip --strict --include dependencies,unlisted,unresolved",
    "test": "vitest run --passWithNoTests",
    "check": "sh .githooks/pre-commit"
  },
  "dependencies": {
    "@solidjs/web": "^2.0.3",
    "midi-file": "^1.2.4",
    "pixi.js": "^8.23.0",
    "solid-js": "^2.0.3"
  },
  "devDependencies": {
    "@solidjs/vite-plugin": "^3.0.1",
    "@types/node": "^24.19.2",
    "@vite-pwa/assets-generator": "^2.0.0",
    "knip": "^6.48.0",
    "oxc-config-ai-guardrails": "^1.1.0",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2008",
    "puppeteer-core": "^25.18.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1",
    "workbox-window": "^7.4.1"
  },
  "packageManager": "pnpm@12.23.0"
}
